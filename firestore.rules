rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo l'email di Ema può leggere e scrivere.
    match /{collezione}/{documento} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'LA_TUA_EMAIL'
        && collezione in ['partite', 'presidi', 'config'];
    }
  }
}
